    "sounds": [ "utdmod:serpent_ambient_loop" ]
  },

  "entity_serpent_attack": {
    "category": "neutral",
    "subtitle": "subtitles.utdmod.coherence_serpent_attack",
    "sounds": [ "utdmod:serpent_attack_roar" ]
  },

  "serpent_ambient": {
    "category": "neutral",
    "subtitle": "subtitles.utdmod.coherence_serpent_ambient",
    "sounds": [ "utdmod:serpent_groan_1", "utdmod:serpent_groan_2" ]
  },

  "entity_wraith_attack": {
    "category": "hostile",
    "subtitle": "subtitles.utdmod.fracture_wraith_attack",
    "sounds": [ "utdmod:wraith_attack_scream" ]
  },

  "entity_wraith_death": {
    "category": "hostile",
